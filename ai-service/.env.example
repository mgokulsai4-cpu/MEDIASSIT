# MedAssist+ AI service configuration

# Server
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5001
LOG_LEVEL=INFO
LANGUAGE=en

# Optional OpenAI-compatible LLM endpoint (Ollama, LM Studio, OpenAI, ...).
# Leave LLM_API_URL empty to use the deterministic offline agents.
# Example for local Ollama: LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30