# MedAssist+ backend configuration
# Copy to .env and adjust.

# Server
PORT=4000
NODE_ENV=development

# Security
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# MongoDB - leave MONGODB_URI empty to use an in-memory MongoDB (development/testing)
# For MongoDB Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/medassist?retryWrites=true&w=majority
MONGODB_URI=
DB_NAME=medassist

# Python AI service (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:5001
AI_SERVICE_TIMEOUT_MS=8000

# Notifications (Expo push) - leave empty to gracefully disable remote delivery
EXPO_ACCESS_TOKEN=

# CORS origins for development (comma separated)
CORS_ORIGINS=*